---
const sinNixumi = [
  'Pierdes ventas fuera de horario de oficina',
  'Tu equipo repite las mismas respuestas 100 veces al día',
  'Los prospectos se enfrían antes de que los contestes',
  'No queda claro quién dio seguimiento a cada conversación',
  'Cotizaciones y datos de producto se responden distinto según quién atienda',
];

const conNixumi = [
  'Atención instantánea 24/7 para primeras respuestas y FAQs',
  'Tu IA responde, cotiza y agenda según las reglas que definamos',
  'Capturas y calificas leads con datos ordenados para seguimiento',
  'Tu equipo puede tomar el control cuando una conversación lo requiere',
  'La información comercial se mantiene consistente en cada chat',
];
---

<section class="aurora-medium py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 md:px-6">

    <!-- Heading -->
    <div class="text-center mb-9 fade-in">
      <p class="nx-eyebrow mb-3">Problema / solución</p>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3" style="color:var(--foreground)">
        ¿Estás perdiendo ventas mientras duermes?
      </h2>
      <p class="text-sm md:text-base max-w-xl mx-auto nx-muted">
        Cada hora sin respuesta es un prospecto que le compra a tu competencia.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6 max-w-4xl mx-auto">

      <!-- Sin Nixumi -->
      <div
        class="fade-in fade-d1 nx-panel p-6"
      >
        <!-- Icon -->
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:color-mix(in srgb, #ef4444 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#EF4444" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </div>
          <h3 class="text-lg font-bold" style="color:var(--foreground)">Sin Nixumi</h3>
        </div>

        <ul class="space-y-3" role="list">
          {sinNixumi.map(item => (
            <li class="flex items-start gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#EF4444" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
              <span class="text-sm leading-snug nx-muted">{item}</span>
            </li>
          ))}
        </ul>

        <!-- Ilustración sutil -->
        <div class="mt-6 rounded-lg p-3 flex items-center gap-3" style="background:color-mix(in srgb, #ef4444 9%, transparent); border:1px solid color-mix(in srgb, #ef4444 22%, transparent)">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#EF4444" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <p class="text-xs font-semibold" style="color:#EF4444">
            El 78% de los leads compra al primero que responde
            <span class="block text-[10px] font-normal mt-1 opacity-70">Fuente: InsideSales.com / Harvard Business Review</span>
          </p>
        </div>
      </div>

      <!-- Con Nixumi -->
      <div
        class="fade-in fade-d2 nx-panel p-6 relative overflow-hidden"
        style="border-color:color-mix(in srgb, var(--primary) 42%, var(--border))"
      >
        <!-- Highlight ribbon -->
        <div
          class="absolute top-0 right-0 text-[10px] font-bold px-3 py-1 rounded-bl-lg"
          style="background:var(--primary); color:var(--primary-foreground)"
        >
          SOLUCIÓN
        </div>

        <!-- Icon -->
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:color-mix(in srgb, var(--primary) 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="var(--primary)" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
          </div>
          <h3 class="text-lg font-bold" style="color:var(--foreground)">Con Nixumi</h3>
        </div>

        <ul class="space-y-3" role="list">
          {conNixumi.map(item => (
            <li class="flex items-start gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="var(--primary)" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              <span class="text-sm leading-snug font-medium" style="color:var(--foreground)">{item}</span>
            </li>
          ))}
        </ul>

        <!-- Stat -->
        <div class="mt-6 rounded-lg p-3 flex items-center gap-3" style="background:color-mix(in srgb, var(--primary) 9%, transparent); border:1px solid color-mix(in srgb, var(--primary) 22%, transparent)">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="var(--primary)" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
          <p class="text-xs font-semibold" style="color:var(--primary)">
            Respuesta automática en menos de 3 segundos, todo el día
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
