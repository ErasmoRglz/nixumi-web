---
const { class: className = '' } = Astro.props;
---

<span class={`meta-badge ${className}`} aria-label="Meta Tech Provider verificado">
  <svg class="meta-badge__mark" viewBox="0 0 64 40" aria-hidden="true">
    <path
      d="M7.8 25.6c0-7.9 4.2-15.3 10.4-15.3 3.6 0 6.8 2.1 10.7 7.1l3.1 4 3.1-4c3.9-5 7.1-7.1 10.7-7.1 6.2 0 10.4 7.4 10.4 15.3 0 5.1-2.5 8.3-6.5 8.3-3.6 0-6.4-2.3-11.4-8.8l-2.2-2.9-4.1 5.5c-4.1 5.3-7 6.2-10 6.2-8.5 0-14.2-3.3-14.2-8.3Zm19-3.7-2.9-3.8c-2.3-3-4-4-5.7-4-3.4 0-6.2 5.5-6.2 11.4 0 3 3.4 4.3 9.5 4.3 1.7 0 3.2-.7 5.3-3.5l2.6-3.5-2.6-.9Zm10.4.9 4.5 5.8c2.9 3.7 5.1 5.3 7.8 5.3 2.2 0 3.4-1.6 3.4-4.3 0-5.9-2.8-11.4-6.2-11.4-1.7 0-3.4 1-5.7 4l-3.8 4.6Z"
      fill="#0866FF"
    />
  </svg>
  <span class="meta-badge__text">Meta Tech Provider</span>
  <svg class="meta-badge__check" viewBox="0 0 20 20" aria-hidden="true">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.7a1 1 0 0 0-1.4-1.4L9 10.2 7.7 8.9a1 1 0 1 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z"
      clip-rule="evenodd"
    />
  </svg>
</span>

<style>
  .meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.42rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.95);
    color: #111827;
    box-shadow: var(--shadow-card);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .meta-badge__mark {
    width: 2rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }

  .meta-badge__text {
    letter-spacing: 0;
  }

  .meta-badge__check {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--primary);
  }
</style>
