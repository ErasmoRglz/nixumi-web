---
type Props = {
  label: string;
  icon?: string;
};

const { label, icon } = Astro.props;
---

<li class="trust-item">
  <span class:list={['trust-item__icon', { 'trust-item__icon--panel': icon }]} aria-hidden="true">
    {icon ? (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        set:html={icon}
      />
    ) : (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
    )}
  </span>
  <span>{label}</span>
</li>

<style>
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .trust-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--primary);
  }

  .trust-item__icon--panel {
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--card) 64%, transparent);
  }
</style>
