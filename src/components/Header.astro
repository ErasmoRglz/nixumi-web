---
const navLinks = [
  { href: '#plataforma', label: 'Plataforma' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso',   label: 'Proceso'   },
  { href: '#casos',     label: 'Casos'     },
  { href: '#precios',   label: 'Precios'   },
  { href: '#faq',       label: 'FAQ'       },
  { href: '#contacto',  label: 'Contacto'  },
];

const LOGIN    = 'https://app.nixumi.lat/login';
const REGISTER = 'https://app.nixumi.lat/register';
---

<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-purple focus:text-white focus:rounded-lg focus:font-medium focus:shadow-lg focus:outline-none">
  Saltar al contenido principal
</a>

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 md:px-6">
     <div class="flex items-center justify-between h-20 md:h-24">

       <!-- Logo -->
       <a href="/" class="flex-shrink-0">
        <img
          src="/nixumi-logo.webp"
          alt="Nixumi - Automatización de WhatsApp con IA"
          width="160"
          height="64"
          class="h-10 sm:h-12 md:h-16 w-auto object-contain block dark:hidden"
        />
        <img
          src="/nixumi-logo-white-text.webp"
          alt="Nixumi - Automatización de WhatsApp con IA"
          width="160"
          height="64"
          class="h-10 sm:h-12 md:h-16 w-auto object-contain hidden dark:block"
        />
      </a>

      <!-- Nav · desktop -->
      <nav class="hidden lg:flex items-center gap-8" role="navigation" aria-label="Navegación principal">
        {navLinks.map(l => (
          <a
            href={l.href}
            class="text-sm font-medium text-navy hover:text-purple transition-colors duration-200"
          >
            {l.label}
          </a>
        ))}
      </nav>

       <!-- CTA · desktop + Hamburger · mobile — alineados a la derecha -->
       <div class="flex items-center gap-2">

      <!-- Toggle dark/light -->
      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema"
        class="inline-flex items-center justify-center w-10 h-10 rounded-full border transition-all duration-200 hover:scale-105"
        style="border-color:rgba(168,181,196,0.5); color:var(--color-navy)"
      >
        <!-- Sol: visible en light mode -->
        <svg data-theme-icon="sun" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <!-- Luna: visible en dark mode -->
        <svg data-theme-icon="moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>

      <!-- CTAs · desktop -->
      <a
        href={LOGIN}
        class="hidden lg:inline-flex btn-nx btn-outline btn-sm"
      >
        Entrar
      </a>
      <a
        href={REGISTER}
        class="hidden lg:inline-flex btn-nx btn-primary btn-sm"
        data-wa-event="cta_register_header"
      >
        Crear cuenta gratis
      </a>

      <!-- Hamburger · mobile -->
      <button
        id="menu-btn"
        class="lg:hidden flex flex-col justify-center gap-[5px] w-9 h-9 rounded-lg hover:bg-slate/20 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="bar1" class="block h-0.5 w-5 mx-auto bg-navy rounded-full transition-all duration-300"></span>
        <span id="bar2" class="block h-0.5 w-5 mx-auto bg-navy rounded-full transition-all duration-300"></span>
        <span id="bar3" class="block h-0.5 w-5 mx-auto bg-navy rounded-full transition-all duration-300"></span>
      </button>
      </div><!-- /right column -->
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-white/95 dark:bg-[#0F1419]/95 backdrop-blur-md border-t border-slate/20 dark:border-slate-700"
  >
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">
      {navLinks.map(l => (
        <a
          href={l.href}
          class="mobile-link text-base font-medium text-navy hover:text-purple py-3 border-b border-slate/10 transition-colors"
        >
          {l.label}
        </a>
      ))}
      <a
        href={LOGIN}
        class="btn-nx btn-outline btn-full mt-3"
      >
        Entrar
      </a>
      <a
        href={REGISTER}
        class="btn-nx btn-primary btn-full mt-2"
        data-wa-event="cta_register_header"
      >
        Crear cuenta gratis
      </a>
    </div>
  </div>
</header>

<script>
  // Header interactions: sticky scroll, hamburger menu, Escape key
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  const mMenu = document.getElementById('mobile-menu')!;
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;
  const bar3 = document.getElementById('bar3')!;
  let menuOpen = false;

  function onScroll() {
    if (window.scrollY > 12) {
      header.classList.add('header-scrolled');
    } else {
      header.classList.remove('header-scrolled');
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function closeMenu() {
    menuOpen = false;
    mMenu.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    bar1.style.transform = '';
    bar2.style.opacity = '';
    bar3.style.transform = '';
  }

  btn.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mMenu.classList.toggle('hidden', !menuOpen);
    btn.setAttribute('aria-expanded', String(menuOpen));
    if (menuOpen) {
      bar1.style.transform = 'translateY(6px) rotate(45deg)';
      bar2.style.opacity = '0';
      bar3.style.transform = 'translateY(-6px) rotate(-45deg)';
    } else {
      closeMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) {
      closeMenu();
      btn.focus();
    }
  });

  document.querySelectorAll('.mobile-link').forEach((a) =>
    a.addEventListener('click', closeMenu),
  );
</script>
