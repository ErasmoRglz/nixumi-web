---
const WA_CASO = 'https://wa.me/5212381238389?text=Hola%2C%20quiero%20ser%20el%20pr%C3%B3ximo%20caso%20de%20%C3%A9xito%20de%20Nixumi';

const metrics = [
  { value: '24/7',    label: 'Atención automatizada' },
  { value: 'En vivo', label: 'Datos conectados' },
  { value: 'Sí',      label: 'Seguimiento fuera de horario' },
];

const stack = [
  'WhatsApp Business',
  'Supabase',
  'n8n',
  'Gemini 2.5 Pro',
];
---

<section id="casos" class="aurora-medium py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 md:px-6">

    <!-- Heading -->
    <div class="text-center mb-9 fade-in">
      <div class="nx-eyebrow mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
        </svg>
        Caso real en producción
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3" style="color:var(--foreground)">
        Implementación real con cliente
      </h2>
      <p class="text-sm md:text-base max-w-xl mx-auto nx-muted">
        No es un demo ni un prototipo: es una implementación en producción atendiendo conversaciones reales de WhatsApp en este momento.
      </p>
    </div>

    <!-- ── Featured case card ── -->
    <div class="max-w-3xl mx-auto fade-in">
      <div
        class="nx-panel p-6 md:p-8"
      >

        <!-- a) Card header row -->
        <div class="flex items-start justify-between gap-4 mb-6">
          <div
            class="nx-soft-chip gap-2 text-xs font-bold px-3 py-1.5"
            style="color:var(--primary)"
          >
            <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--primary)"></span>
            Caso en producción
          </div>
          <span
            class="nx-soft-chip text-xs font-semibold px-3 py-1.5"
          >
            Bienes raíces
          </span>
        </div>

        <!-- b) Client name -->
        <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-2" style="color:var(--foreground)">
          Inmobiliaria El Valle Bagoj
        </h3>

        <!-- c) Location -->
        <p class="text-sm mb-6 nx-muted">
          📍 Altepexi, Puebla · México
        </p>

        <!-- d) Divider -->
        <div class="border-t mb-6" style="border-color:var(--border)"></div>

        <!-- e) Metrics -->
        <div class="grid grid-cols-3 gap-4 mb-6">
          {metrics.map((m, i) => (
            <div class={`text-center fade-in fade-d${i + 1}`}>
              <p
                class="text-3xl md:text-4xl font-extrabold tracking-tight leading-none"
                style="color:var(--accent); font-family:var(--font-mono)"
              >
                {m.value}
              </p>
              <p class="text-xs font-medium mt-2 leading-snug nx-muted">
                {m.label}
              </p>
            </div>
          ))}
        </div>

        <!-- f) Divider -->
        <div class="border-t mb-6" style="border-color:var(--border)"></div>

        <!-- g) Description -->
        <p class="text-sm md:text-base leading-relaxed max-w-prose mb-6 nx-muted">
          Automatizamos la atención al cliente de una inmobiliaria con múltiples
          lotificaciones activas. <strong style="color:var(--foreground)">"Graciela"</strong>
          —la asesora virtual de IA— atiende, cotiza lotes con precios reales
          desde base de datos y agenda visitas sin intervención humana, incluso
          en madrugada y fines de semana. Graciela corre sobre la plataforma Nixumi.
        </p>

        <!-- h) Tech stack chips -->
        <div class="flex flex-wrap gap-2">
          {stack.map(t => (
            <span
              class="nx-soft-chip text-xs font-medium px-3 py-1"
            >
              {t}
            </span>
          ))}
        </div>

      </div>

      <!-- ── Below card: next case CTA ── -->
      <div class="text-center mt-6 fade-in">
        <a
          href={WA_CASO}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-nx btn-primary btn-sm"
          data-wa-event="wa_click_cases"
        >
          Hablar con Nixumi
          <svg xmlns="http://www.w3.org/2000/svg" class="btn-arrow h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>
