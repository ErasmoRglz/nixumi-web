---
---

<div id="lead-form-section" class="py-12 md:py-16">
  <div class="max-w-xl mx-auto px-4 md:px-6">
    <div class="text-center mb-8">
      <p class="nx-eyebrow mb-3">Diagnóstico</p>
      <h2 id="form-title" class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--foreground)">
        ¿Listo para automatizar tu negocio?
      </h2>
      <p id="form-subtitle" class="text-sm md:text-base nx-muted">
        Te escribiremos por WhatsApp en menos de 24 horas para agendar tu diagnóstico gratuito de 30 minutos. Sin costo, sin compromiso.
      </p>
    </div>

    <form id="lead-form" class="nx-panel space-y-4 p-5 md:p-6">
      <div>
        <label for="nombre" class="block text-sm font-semibold mb-1.5" style="color: var(--foreground)">
          Nombre completo
        </label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          required
          minlength="3"
          maxlength="100"
          placeholder="Ej. Juan Pérez"
          oninvalid="this.setCustomValidity('El nombre debe tener al menos 3 caracteres.')"
          oninput="this.setCustomValidity('')"
          class="lead-input w-full px-3 py-3 rounded-lg text-sm transition-all"
        />
      </div>

      <div>
        <label for="whatsapp" class="block text-sm font-semibold mb-1.5" style="color: var(--foreground)">
          Número de WhatsApp
        </label>
        <div class="lead-input-group flex rounded-lg transition-all overflow-hidden">
          <span class="flex items-center px-3 py-3 text-sm font-semibold select-none whitespace-nowrap shrink-0" style="color: var(--foreground); background:color-mix(in srgb, var(--card) 70%, var(--background))">+52</span>
          <input
            type="tel"
            id="whatsapp"
            name="whatsapp"
            required
            placeholder="55 1234 5678"
            oninvalid="this.setCustomValidity('El número de WhatsApp es obligatorio.')"
            oninput="this.setCustomValidity('')"
            class="w-full px-3 py-3 text-sm bg-transparent border-none outline-none"
            style="color:var(--foreground)"
          />
        </div>
        <p class="text-xs mt-1.5 nx-muted">Ingresa los 10 dígitos de tu número. Ej: 55 1234 5678</p>
      </div>

      <div>
        <label for="negocio" class="block text-sm font-semibold mb-1.5" style="color: var(--foreground)">
          Nombre de tu negocio
        </label>
        <input
          type="text"
          id="negocio"
          name="negocio"
          required
          minlength="2"
          maxlength="100"
          placeholder="Ej. Inmobiliaria El Valle"
          oninvalid="this.setCustomValidity('El nombre del negocio debe tener al menos 2 caracteres.')"
          oninput="this.setCustomValidity('')"
          class="lead-input w-full px-3 py-3 rounded-lg text-sm transition-all"
        />
      </div>

      <!-- Honeypot anti-spam (invisible para humanos) -->
      <div style="position:absolute;left:-9999px" aria-hidden="true">
        <label for="website">No llenar</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <!-- Checkbox de consentimiento -->
      <div class="mb-4">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="consentimiento"
            name="consentimiento"
            required
            oninvalid="this.setCustomValidity('Debes aceptar el Aviso de Privacidad para continuar.')"
            oninput="this.setCustomValidity('')"
            class="mt-1 h-4 w-4 rounded"
            style="accent-color:var(--primary)"
          />
          <span class="text-sm leading-relaxed nx-muted">
            Acepto el
            <a href="/aviso-de-privacidad" target="_blank" class="font-semibold underline underline-offset-2 transition-colors" style="color:var(--primary)">
              Aviso de Privacidad
            </a>
            y autorizo el tratamiento de mis datos personales para recibir información sobre los servicios de Nixumi.
          </span>
        </label>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full btn-nx btn-primary btn-lg flex items-center justify-center gap-2"
      >
        <span>Quiero mi diagnóstico gratis</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </button>
    </form>

    <div id="success-content" class="hidden nx-panel text-center py-8 px-5">
      <div class="w-16 h-16 mx-auto mb-5 rounded-lg flex items-center justify-center" style="background:color-mix(in srgb, var(--primary) 10%, transparent)">
        <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
          <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" stroke="var(--primary)" stroke-width="2"/>
          <path class="checkmark-check" fill="none" stroke="var(--primary)" stroke-width="2" d="M14 27l7 7 16-16"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold mb-3" style="color: var(--foreground)">¡Gracias por confiar en Nixumi! 🎉</h3>
      <p class="text-sm md:text-base nx-muted mb-6">
        Hemos recibido tus datos correctamente. En las próximas 24 horas te escribiremos por WhatsApp para agendar tu diagnóstico gratuito de 30 minutos. Mientras tanto, si tienes alguna duda, escríbenos directamente.
      </p>
      <a href="/" class="btn-nx btn-outline btn-sm">
        ← Volver al inicio
      </a>
    </div>

    <div id="error-content" class="hidden text-center py-3 px-4 rounded-lg mt-4" style="background:color-mix(in srgb, #ef4444 10%, transparent); border:1px solid color-mix(in srgb, #ef4444 28%, var(--border))">
      <p id="error-message" class="text-red-600 dark:text-red-400 font-medium"></p>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successContent = document.getElementById('success-content') as HTMLDivElement;
  const errorContent = document.getElementById('error-content') as HTMLDivElement;
  const errorMessage = document.getElementById('error-message') as HTMLParagraphElement;
  const formTitle = document.getElementById('form-title') as HTMLHeadingElement;
  const formSubtitle = document.getElementById('form-subtitle') as HTMLParagraphElement;

// Credenciales de Supabase (anon key = pública por diseño, segura con RLS)
const SUPABASE_URL = 'https://jtwsjvkltdrjxpisnzyi.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp0d3NqdmtsdGRyanhwaXNuenlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU3MjQzNjIsImV4cCI6MjA5MTMwMDM2Mn0.bx_YAMpLyhEaIgxnb7LQ_61F-rQ92f2YQBMk0m9vE2Q';

// Máscara de formato para el campo WhatsApp (formato: 123 456 7890)
  const whatsappInput = document.getElementById('whatsapp') as HTMLInputElement;
  whatsappInput.addEventListener('input', () => {
    let digits = whatsappInput.value.replace(/[^0-9]/g, '');
    // Limitar a 10 dígitos
    digits = digits.slice(0, 10);
    // Formato: 3-3-4 (XXX XXX XXXX)
    let formatted = '';
    for (let i = 0; i < digits.length; i++) {
      if (i === 3 || i === 6) formatted += ' ';
      formatted += digits[i];
    }
    whatsappInput.value = formatted;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Limpiar errores previos
    errorContent.classList.add('hidden');
    errorMessage.textContent = '';
    
    const formData = new FormData(form);
    const nombre = (formData.get('nombre')?.toString() || '').trim();
    const whatsapp = (formData.get('whatsapp')?.toString() || '').trim();
    const negocio = (formData.get('negocio')?.toString() || '').trim();

    // Validaciones básicas
    if (!nombre || nombre.length < 3) {
      errorMessage.textContent = 'El nombre debe tener al menos 3 caracteres.';
      errorContent.classList.remove('hidden');
      return;
    }

    // Limpiar el número de teléfono (solo dígitos) y anteponer 52
    const whatsappLimpio = '52' + whatsapp.replace(/[^0-9]/g, '');
    if (whatsappLimpio.length !== 12) {
      errorMessage.textContent = 'El número de WhatsApp debe tener 10 dígitos después del +52.';
      errorContent.classList.remove('hidden');
      return;
    }

    if (!negocio || negocio.length < 2) {
      errorMessage.textContent = 'El nombre del negocio debe tener al menos 2 caracteres.';
      errorContent.classList.remove('hidden');
      return;
    }

    // Verificar honeypot (si tiene contenido, es bot)
    const website = (formData.get('website')?.toString() || '').trim();
    if (website) {
      // Bot detectado — fingir éxito sin enviar
      formTitle.classList.add('hidden');
      formSubtitle.classList.add('hidden');
      form.classList.add('hidden');
      successContent.classList.remove('hidden');
      return;
    }

    const data = {
      nombre_completo: nombre,
      whatsapp: whatsappLimpio,
      nombre_negocio: negocio,
    };

    try {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Enviando...</span>
      `;

      const response = await fetch(`${SUPABASE_URL}/rest/v1/leads`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(data)
      });

      // Verificar primero el código de estado HTTP
      if (response.status === 201 || response.status === 200 || response.status === 204) {
        // Éxito: los datos se guardaron correctamente
        formTitle.classList.add('hidden');
        formSubtitle.classList.add('hidden');
        form.classList.add('hidden');
        
        // Mostrar mensaje de éxito
        successContent.classList.remove('hidden');
      } else if (response.status === 409) {
        throw new Error('Este número de WhatsApp ya fue registrado anteriormente. Si crees que es un error, contáctanos directamente.');
      } else if (response.status === 400) {
        throw new Error('Datos inválidos. Verifica la información capturada.');
      } else if (response.status === 401 || response.status === 403) {
        throw new Error('Error de autenticación. Verifica la configuración del sistema.');
      } else {
        // Detectar respuestas HTML (páginas de error de Vercel, Cloudflare, etc.)
        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('text/html')) {
          throw new Error('El servidor no está disponible en este momento. Inténtalo de nuevo más tarde.');
        }
        throw new Error('Error del servidor. Inténtalo de nuevo más tarde.');
      }
    } catch (error: any) {
      console.error('Error completo:', error);
      
      submitBtn.disabled = false;
      submitBtn.innerHTML = `
        <span>Quiero mi diagnóstico gratis</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      `;
      
      // Mostrar mensaje de error en español
      let mensajeError = 'Hubo un error al enviar los datos. Inténtalo de nuevo.';
      
      if (error.message) {
        mensajeError = error.message;
      }
      
      if (error.message?.includes('Failed to fetch') || error.message?.includes('NetworkError')) {
        mensajeError = 'Error de conexión. Verifica tu conexión a internet e inténtalo de nuevo.';
      }
      
      errorMessage.textContent = mensajeError;
      errorContent.classList.remove('hidden');
    }
  });
</script>

<style>
  #lead-form-section {
    background: color-mix(in srgb, var(--background) 88%, transparent);
  }

  .lead-input,
  .lead-input-group {
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 88%, var(--background));
    color: var(--foreground);
  }

  .lead-input::placeholder,
  .lead-input-group input::placeholder {
    color: color-mix(in srgb, var(--muted-foreground) 72%, transparent);
  }

  .lead-input:focus,
  .lead-input-group:focus-within {
    outline: none;
    border-color: var(--ring);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ring) 24%, transparent);
  }

  /* Animación del checkmark */
  .checkmark-circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    stroke-width: 2;
    stroke-miterlimit: 10;
    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
  }
  .checkmark-check {
    transform-origin: 50% 50%;
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    stroke-width: 2;
    animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.6s forwards;
  }
  @keyframes stroke {
    100% {
      stroke-dashoffset: 0;
    }
  }
</style>
