---
import '../styles/global.css';
import '../styles/aurora.css';

// Configuración de Google Calendar
const GOOGLE_CALENDAR_URL = 'https://calendar.app.google/DDciUF8vhgfGDLJm7';

// Generar los próximos 3 días hábiles
function getNextBusinessDays() {
  const days = [];
  const today = new Date();
  let added = 0;
  let current = new Date(today);
  current.setDate(current.getDate() + 1); // Empezar desde mañana

  while (added < 3) {
    const dayOfWeek = current.getDay();
    // 0 = Domingo, 6 = Sábado
    if (dayOfWeek !== 0 && dayOfWeek !== 6) {
      const date = current.toISOString().split('T')[0];
      days.push({
        date: date,
        display: current.toLocaleDateString('es-MX', { 
          weekday: 'long', 
          day: 'numeric', 
          month: 'short' 
        })
      });
      added++;
    }
    current.setDate(current.getDate() + 1);
  }

  return days;
}

const businessDays = getNextBusinessDays();
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/jpeg" href="/logo-white-bg.jpg" />
  <link rel="apple-touch-icon" href="/logo-white-bg.jpg" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO -->
  <title>Reserva tu cita - Nixumi</title>
  <meta name="description" content="Agenda una asesoría gratuita de 30 minutos con Nixumi. Descubre cómo automatizar tu negocio en WhatsApp con IA." />

  <!-- Open Graph -->
  <meta property="og:title" content="Reserva tu cita - Nixumi" />
  <meta property="og:description" content="Agenda una asesoría gratuita de 30 minutos con Nixumi. Descubre cómo automatizar tu negocio en WhatsApp con IA." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.nixumi.lat/reserva-cita" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:image" content="https://www.nixumi.lat/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nixumi — Automatización de WhatsApp con IA" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Reserva tu cita - Nixumi" />
  <meta name="twitter:description" content="Agenda una asesoría gratuita de 30 minutos con Nixumi." />
  <meta name="twitter:image" content="https://www.nixumi.lat/og-image.jpg" />

  <!-- Anti-FOUC: aplica .dark antes del primer render (default dark, igual que index.astro) -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('nixumi-theme'); } catch (e) {}
      var theme = (stored === 'light' || stored === 'dark')
        ? stored
        : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      var root = document.documentElement;
      root.dataset.theme = theme;
      root.classList.toggle('dark', theme === 'dark');
    })();
  </script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />
</head>
<body class="antialiased">
  <!-- Theme toggle flotante -->
  <div class="fixed top-4 right-4 z-50">
    <button
      type="button"
      data-theme-toggle
      aria-label="Cambiar tema"
      class="inline-flex items-center justify-center w-10 h-10 rounded-full border transition-all duration-200 hover:scale-105 bg-white dark:bg-slate-800"
      style="border-color:rgba(168,181,196,0.5); color:var(--color-navy)"
    >
      <!-- Sol: visible en light mode -->
      <svg data-theme-icon="sun" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
      </svg>
      <!-- Luna: visible en dark mode -->
      <svg data-theme-icon="moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
      </svg>
    </button>
  </div>

  <div class="min-h-screen py-20 bg-white dark:bg-slate-900">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <!-- Header -->
      <div class="text-center mb-12">
        <a href="/" class="inline-block mb-8">
          <img
            src="/nixumi-logo.webp"
            alt="Nixumi"
            width="120"
            height="48"
            class="h-12 w-auto mx-auto block dark:hidden"
          />
          <img
            src="/nixumi-logo-white-text.webp"
            alt="Nixumi"
            width="120"
            height="48"
            class="h-12 w-auto mx-auto hidden dark:block"
          />
        </a>
        <h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--color-navy)">
          Reserva tu demo
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-300">
          Selecciona el día que prefieras para tu asesoría gratuita de 30 minutos.
        </p>
      </div>

      <!-- Días disponibles -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {businessDays.map((day, i) => (
          <a
            href={GOOGLE_CALENDAR_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-6 rounded-xl border-2 border-slate-200 dark:border-slate-700 hover:shadow-lg transition-all duration-200 group"
            onmouseover="this.style.borderColor='var(--color-purple)'" onmouseout="this.style.borderColor=''"
          >
            <div class="text-center">
              <div class="w-12 h-12 mx-auto mb-3 rounded-full flex items-center justify-center transition-colors" style="background-color: color-mix(in srgb, var(--color-green) 10%, transparent);">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="color:var(--color-green)">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <p class="font-semibold text-lg mb-1 capitalize" style="color: var(--color-navy)" data-day-slot={i}>
                {day.display}
              </p>
              <p class="text-sm text-slate-500">
                9:00 AM - 6:00 PM
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- Instrucciones -->
      <div class="bg-white dark:bg-slate-800 rounded-xl p-8 shadow-sm">
        <h2 class="text-xl font-semibold mb-4" style="color: var(--color-navy)">
          ¿Qué pasa después?
        </h2>
        <ol class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: color-mix(in srgb, var(--color-green) 10%, transparent); color: var(--color-green);">
              1
            </span>
            <p class="text-slate-600 dark:text-slate-300">
              <strong>Haz clic en un día:</strong> Elige el día que mejor te convenga de los disponibles.
            </p>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: color-mix(in srgb, var(--color-green) 10%, transparent); color: var(--color-green);">
              2
            </span>
            <p class="text-slate-600 dark:text-slate-300">
              <strong>Elige tu horario:</strong> Serás redirigido a Google Calendar para seleccionar la hora exacta.
            </p>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: color-mix(in srgb, var(--color-green) 10%, transparent); color: var(--color-green);">
              3
            </span>
            <p class="text-slate-600 dark:text-slate-300">
              <strong>Recibe confirmación:</strong> Recibirás un correo de confirmación con los detalles de tu cita.
            </p>
          </li>
        </ol>
      </div>

      <!-- Botón de regreso -->
      <div class="mt-12 text-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition-colors"
          onmouseover="this.style.color='var(--color-purple)'" onmouseout="this.style.color=''"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </div>

  <!-- Theme toggle script -->
  <script>
    import { initTheme } from '../scripts/theme';
    initTheme();
  </script>

  <!-- Fechas frescas en cliente: el sitio es estático, así que las fechas
       renderizadas en build se quedan congeladas. Recalculamos los próximos
       3 días hábiles en cada carga para no mostrar nunca fechas pasadas. -->
  <script>
    function nextBusinessDays(n: number): string[] {
      const out: string[] = [];
      const cur = new Date();
      cur.setDate(cur.getDate() + 1); // empezar mañana
      while (out.length < n) {
        const dow = cur.getDay();
        if (dow !== 0 && dow !== 6) {
          out.push(
            cur.toLocaleDateString('es-MX', {
              weekday: 'long',
              day: 'numeric',
              month: 'short',
            }),
          );
        }
        cur.setDate(cur.getDate() + 1);
      }
      return out;
    }

    const days = nextBusinessDays(3);
    document.querySelectorAll<HTMLElement>('[data-day-slot]').forEach((el) => {
      const i = Number(el.dataset.daySlot);
      if (!Number.isNaN(i) && days[i]) el.textContent = days[i];
    });
  </script>
</body>
</html>
