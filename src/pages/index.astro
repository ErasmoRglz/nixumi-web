---
import '../styles/global.css';
import '../styles/aurora.css';
import Header          from '../components/Header.astro';
import Hero             from '../components/Hero.astro';
import ProblemSolution  from '../components/ProblemSolution.astro';
import DosFormas from '../components/DosFormas.astro';
import Services         from '../components/Services.astro';
import Cases            from '../components/Cases.astro';
import Process          from '../components/Process.astro';
import Pricing          from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer           from '../components/Footer.astro';
import AnalyticsConsent  from '../components/AnalyticsConsent.astro';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/jpeg" href="/logo-white-bg.jpg" />
  <link rel="apple-touch-icon" href="/logo-white-bg.jpg" />
  <meta name="generator" content={Astro.generator} />
  <meta name="facebook-domain-verification" content="dwowhmydfekq9zl0q2giceurfoiha0" />

  <!-- SEO -->
  <title>Nixumi — Plataforma de WhatsApp con IA + chatbots · Meta Tech Provider</title>
  <meta name="description" content="Plataforma de WhatsApp Business con IA: conecta tu canal gratis y automatiza con tus herramientas, o deja que Nixumi diseñe y opere tu chatbot. Meta Tech Provider verificado." />

  <!-- Canonical URL -->
  <link rel="canonical" href="https://www.nixumi.lat/" />

  <!-- Open Graph -->
  <meta property="og:title" content="Nixumi — Plataforma de WhatsApp con IA · Meta Tech Provider" />
  <meta property="og:description" content="Conecta tu WhatsApp gratis y automatiza con tus herramientas, o contrata el servicio gestionado. Meta Tech Provider verificado." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.nixumi.lat/" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:image" content="https://www.nixumi.lat/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nixumi — Automatización de WhatsApp con IA para tu negocio" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Nixumi — Plataforma de WhatsApp con IA · Meta Tech Provider" />
  <meta name="twitter:description" content="Conecta tu WhatsApp gratis y automatiza con tus herramientas, o contrata el servicio gestionado. Meta Tech Provider verificado." />
  <meta name="twitter:image" content="https://www.nixumi.lat/og-image.jpg" />
  <meta name="twitter:image:alt" content="Nixumi — Automatización de WhatsApp con IA para tu negocio" />


  <!-- Anti-FOUC: aplica .dark antes del primer render (default dark) -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('nixumi-theme'); } catch (e) {}
      var theme = (stored === 'light' || stored === 'dark')
        ? stored
        : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      var root = document.documentElement;
      root.dataset.theme = theme;
      root.classList.toggle('dark', theme === 'dark');
    })();
  </script>

  <!-- Google Fonts: IBM Plex Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="antialiased">

  <!-- Aurora global — fondo animado fijo detrás de toda la página -->
  <div class="aurora-global" aria-hidden="true">
    <div class="ap-beam ap-beam-1"></div>
    <div class="ap-beam ap-beam-2"></div>
    <div class="ap-beam ap-beam-3"></div>
  </div>

  <Header />
  <main id="main-content" class="relative" style="z-index:1">
    <Hero />
    <ProblemSolution />
    <DosFormas />
    <Services />
    <Cases />
    <Process />
    <Pricing />
<FAQ />
<LeadForm />
<CTAFinal />
  </main>

  <Footer />

  <!-- Banner de consentimiento + carga condicional de Google Analytics 4 -->
  <AnalyticsConsent />

  <!-- Theme: detección de sistema + toggle + persistencia -->
  <script>
    import { initTheme } from '../scripts/theme';
    initTheme();
  </script>

  <!-- Intersection Observer for fade-in animations -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
  </script>

  <!-- Tracking de eventos WhatsApp y formulario (defensivo: solo si GA4 fue cargado) -->
  <script>
  // Tracking de eventos WhatsApp
  document.querySelectorAll('[data-wa-event]').forEach(el => {
    el.addEventListener('click', () => {
      const eventName = el.dataset.waEvent;
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, { event_category: 'whatsapp' });
      }
    });
  });

  // Tracking de formulario
  document.addEventListener('formSubmitSuccess', () => {
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'form_submit_success', { event_category: 'lead' });
    }
  });
  </script>

</body>
</html>
